{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mtg-ai-trainer/schemas/judge-scenario.json",
  "title": "MTG AI Trainer Judge Scenario",
  "type": "object",
  "required": ["id", "title", "tags", "complexity", "players", "startingState", "actions", "expectedChoices", "expectedOutcome", "rulesReferences", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^J36-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "complexity": {"enum": ["basic", "advanced", "expert"]},
    "players": {"type": "integer", "minimum": 2, "maximum": 4},
    "startingState": {
      "type": "object",
      "required": ["phase", "battlefield", "hands", "otherZones"],
      "properties": {
        "phase": {"type": "string"},
        "activePlayer": {"type": "string"},
        "battlefield": {"type": "array", "items": {"type": "string"}},
        "hands": {"type": "array", "items": {"type": "string"}},
        "otherZones": {"type": "array", "items": {"type": "string"}}
      }
    },
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expectedChoices": {"type": "array", "items": {"type": "string"}},
    "expectedOutcome": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rulesReferences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "notes": {"type": "string", "minLength": 1},
    "traceSnapshot": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
