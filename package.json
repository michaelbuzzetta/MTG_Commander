{
  "name": "mtg-ai-trainer-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import-archidekt": "node scripts/import-archidekt-decks.mjs",
    "import-user-decks": "node scripts/import-user-decks.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-db": "node scripts/build-card-db.mjs",
    "build-db:refresh": "node scripts/build-card-db.mjs --refresh-scryfall",
    "check-db": "node scripts/build-card-db.mjs --check",
    "test": "node --test tests/*.test.js",
    "test:stress": "node --test tests/stress.test.js",
    "verify": "npm run check-db && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {}
}
